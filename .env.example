# AWY Application Environment Configuration Example

PROJECT_NAME=AWY Automotive Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Settings
POSTGRES_USER=awy_user
POSTGRES_PASSWORD=awy_password
POSTGRES_DB=awy_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://awy_user:awy_password@postgres:5432/awy_db

# Qdrant Settings
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=automotive_reviews

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# API Settings
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-awy-secret-key-2026
